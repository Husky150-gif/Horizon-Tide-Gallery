rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'horizontidegallery@gmail.com',
          'musicisbae6547@gmail.com',
          'littlelopsidestudio@gmail.com'
        ];
    }

    // Public preorder reference uploads.
    match /references/{allPaths=**} {
      allow create: if request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow read, delete: if isAdmin();
    }

    // Premade catalog images are admin-managed content.
    match /premade-keychains/{allPaths=**} {
      allow create, update, delete: if isAdmin()
        && request.resource != null
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow read: if true;
    }

    // Default deny for any other object path.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
