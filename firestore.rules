rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email in [
        'horizontidegallery@gmail.com',
        'musicisbae6547@gmail.com',
        'littlelopsidestudio@gmail.com'
      ];
    }

    function preorderAllowedKeys() {
      return request.resource.data.keys().hasOnly([
        'name',
        'email',
        'discord',
        'socialHandle',
        'orderType',
        'itemType',
        'orderId',
        'status',
        'notes',
        'description',
        'materials',
        'pose',
        'species',
        'deadline',
        'quantity',
        'artType',
        'shadingStyle',
        'characterCount',
        'selectedAddons',
        'partType',
        'keychainType',
        'stickerType',
        'needsMeasurements',
        'refLink',
        'referenceImageUrls',
        'createdAt'
      ]);
    }

    function preorderHasSafeDefaults() {
      return request.resource.data.orderId is string
        && request.resource.data.orderId.matches('^HTG-[0-9]{4}-[A-Z0-9]{6}$')
        && (
          (('orderType' in request.resource.data.keys()) && request.resource.data.orderType is string)
          || (('itemType' in request.resource.data.keys()) && request.resource.data.itemType is string)
        )
        && request.resource.data.name is string
        && request.resource.data.status == 'Pending Review'
        && request.resource.data.createdAt == request.time
        && (!('email' in request.resource.data.keys()) || request.resource.data.email is string)
        && (!('discord' in request.resource.data.keys()) || request.resource.data.discord is string)
        && (!('socialHandle' in request.resource.data.keys()) || request.resource.data.socialHandle is string)
        && !('adminNotes' in request.resource.data.keys())
        && !('privateNotes' in request.resource.data.keys())
        && !('paymentStatus' in request.resource.data.keys())
        && !('refundStatus' in request.resource.data.keys())
        && !('isPrivate' in request.resource.data.keys());
    }

    function isShortString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function optionalShortString(fieldName, maxLen) {
      return !(fieldName in request.resource.data.keys())
        || (request.resource.data[fieldName] is string && request.resource.data[fieldName].size() <= maxLen);
    }

    function optionalBool(fieldName) {
      return !(fieldName in request.resource.data.keys()) || request.resource.data[fieldName] is bool;
    }

    function optionalStringList(fieldName, maxItems) {
      return !(fieldName in request.resource.data.keys())
        || (
          request.resource.data[fieldName] is list
          && request.resource.data[fieldName].size() <= maxItems
          && (request.resource.data[fieldName].size() < 1 || request.resource.data[fieldName][0] is string)
          && (request.resource.data[fieldName].size() < 2 || request.resource.data[fieldName][1] is string)
          && (request.resource.data[fieldName].size() < 3 || request.resource.data[fieldName][2] is string)
          && (request.resource.data[fieldName].size() < 4 || request.resource.data[fieldName][3] is string)
        );
    }

    function commentAllowedKeys() {
      return request.resource.data.keys().hasOnly([
        'name',
        'text',
        'replies',
        'timestamp',
        'entryType',
        'approved',
        'safeForPublic',
        'displayName',
        'rating',
        'reviewRating',
        'reviewText',
        'commissionType',
        'reviewImageUrl'
      ]);
    }

    function commentIsBasicEntry() {
      return isShortString(request.resource.data.name, 50)
        && isShortString(request.resource.data.text, 500)
        && request.resource.data.timestamp == request.time
        && request.resource.data.replies is list
        && request.resource.data.replies.size() == 0
        && !('entryType' in request.resource.data.keys());
    }

    function commentIsReviewEntry() {
      return request.resource.data.entryType == 'review'
        && isShortString(request.resource.data.displayName, 50)
        && isShortString(request.resource.data.name, 50)
        && isShortString(request.resource.data.reviewText, 1500)
        && isShortString(request.resource.data.text, 1500)
        && request.resource.data.timestamp == request.time
        && request.resource.data.replies is list
        && request.resource.data.replies.size() == 0
        && request.resource.data.approved == false
        && request.resource.data.safeForPublic == false
        && request.resource.data.rating is int
        && request.resource.data.reviewRating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.reviewRating >= 1
        && request.resource.data.reviewRating <= 5
        && optionalShortString('commissionType', 80)
        && optionalShortString('reviewImageUrl', 700);
    }

    function reportAllowedKeys() {
      return request.resource.data.keys().hasOnly([
        'commentId',
        'commentText',
        'reporterEmail',
        'reason',
        'createdAt',
        'to',
        'message',
        'orderId',
        'requestType',
        'requestStatus',
        'uploadLink',
        'attachmentUrls',
        'attachmentCount',
        'discordHandle',
        'dmAlertsEnabled'
      ]);
    }

    function reportHasSafeDefaults() {
      return isShortString(request.resource.data.commentId, 140)
        && optionalShortString('commentText', 4000)
        && optionalShortString('reporterEmail', 160)
        && optionalShortString('reason', 120)
        && optionalShortString('orderId', 32)
        && optionalShortString('requestStatus', 32)
        && optionalShortString('uploadLink', 700)
        && optionalShortString('discordHandle', 80)
        && optionalBool('dmAlertsEnabled')
        && optionalStringList('attachmentUrls', 4)
        && (
          !('attachmentCount' in request.resource.data.keys())
          || (
            request.resource.data.attachmentCount is int
            && request.resource.data.attachmentCount >= 0
            && request.resource.data.attachmentCount <= 4
          )
        )
        && (
          !('requestType' in request.resource.data.keys())
          || request.resource.data.requestType.matches('^customer_[a-z0-9_]{2,64}$')
        )
        && (
          !('to' in request.resource.data.keys())
          || (
            request.resource.data.to is list
            && request.resource.data.to.size() <= 3
            && (request.resource.data.to.size() < 1 || request.resource.data.to[0] is string)
            && (request.resource.data.to.size() < 2 || request.resource.data.to[1] is string)
            && (request.resource.data.to.size() < 3 || request.resource.data.to[2] is string)
          )
        )
        && (
          !('message' in request.resource.data.keys())
          || (
            request.resource.data.message is map
            && request.resource.data.message.keys().hasOnly(['subject', 'text', 'html'])
            && (
              !('subject' in request.resource.data.message.keys())
              || (request.resource.data.message.subject is string && request.resource.data.message.subject.size() <= 180)
            )
            && (
              !('text' in request.resource.data.message.keys())
              || (request.resource.data.message.text is string && request.resource.data.message.text.size() <= 6000)
            )
            && (
              !('html' in request.resource.data.message.keys())
              || (request.resource.data.message.html is string && request.resource.data.message.html.size() <= 12000)
            )
          )
        )
        && request.resource.data.createdAt == request.time;
    }

    match /preorders/{orderDocId} {
      allow create: if preorderAllowedKeys() && preorderHasSafeDefaults();
      allow get, list, update, delete: if isAdmin();
    }

    match /preorderStatusPublic/{orderId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['orderId', 'orderType', 'status', 'createdAt', 'updatedAt', 'publicReferenceImageUrls'])
        && request.resource.data.orderId == orderId
        && request.resource.data.orderId is string
        && request.resource.data.orderId.matches('^HTG-[0-9]{4}-[A-Z0-9]{6}$')
        && request.resource.data.orderType is string
        && request.resource.data.status == 'Pending Review'
        && request.resource.data.createdAt == request.time
        && optionalStringList('publicReferenceImageUrls', 4)
        && request.resource.data.updatedAt == request.time
      );
      allow update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow get, list: if isAdmin() || resource.data.visible == true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /inventoryEvents/{eventId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /refunds/{refundId} {
      allow get, list: if isAdmin() || resource.data.isPublic == true;
      allow create, update, delete: if isAdmin();
    }

    match /commissions/{commissionId} {
      allow get, list: if isAdmin() || resource.data.isPublic == true;
      allow create, update, delete: if isAdmin();
    }

    match /refundPrivate/{refundPrivateId} {
      allow read, write: if isAdmin();
    }

    match /commissionPrivate/{commissionPrivateId} {
      allow read, write: if isAdmin();
    }

    match /comments/{commentId} {
      allow get, list: if true;
      allow create: if commentAllowedKeys() && (commentIsBasicEntry() || commentIsReviewEntry());
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if reportAllowedKeys() && reportHasSafeDefaults();
      allow get, list, update, delete: if isAdmin();
    }

    match /analyticsEvents/{eventId} {
      allow create: if request.resource.data.keys().hasOnly([
          'event',
          'page',
          'route',
          'source',
          'status',
          'isAdminSession',
          'createdAt'
        ])
        && request.resource.data.event is string
        && request.resource.data.page is string
        && request.resource.data.route is string
        && request.resource.data.source is string
        && request.resource.data.status is string
        && request.resource.data.event.size() >= 2
        && request.resource.data.event.size() <= 64
        && request.resource.data.event.matches('^[a-z0-9_:-]+$')
        && request.resource.data.page.size() <= 64
        && request.resource.data.route.size() <= 80
        && request.resource.data.source.size() <= 64
        && request.resource.data.status.size() <= 48
        && request.resource.data.isAdminSession is bool
        && request.resource.data.createdAt == request.time;
      allow get, list, update, delete: if isAdmin();
    }

    match /clientErrorReports/{reportId} {
      allow create: if request.resource.data.keys().hasOnly([
          'kind',
          'message',
          'page',
          'route',
          'source',
          'userAgent',
          'isAdminSession',
          'createdAt'
        ])
        && request.resource.data.kind is string
        && request.resource.data.kind.size() >= 2
        && request.resource.data.kind.size() <= 48
        && request.resource.data.kind.matches('^[a-z0-9_:-]+$')
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 220
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 64
        && request.resource.data.route is string
        && request.resource.data.route.size() <= 80
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 180
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 320
        && request.resource.data.isAdminSession is bool
        && request.resource.data.createdAt == request.time;
      allow get, list, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
